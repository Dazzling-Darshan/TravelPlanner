PORT=5000
# MongoDB connection URI (Atlas or Local)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/travel-around?retryWrites=true&w=majority
# For Local MongoDB: mongodb://localhost:27017/travel-around
MONGO_URI=mongodb://localhost:27017/travel-around

# Secret used to sign session cookies
SESSION_SECRET=your_super_secret_session_key_here

# Environment (development / production)
NODE_ENV=development
